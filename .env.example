# ── Fuentes de datos ──────────────────────────────────────────
QQP_DATOS_URL=          # DEPRECADO (PROFECO reemplazado por scraping directo)
DATOS_ABIERTOS_URL=
GASOLINA_HMO_URL=
CASA_LEY_URL=
ABARREY_URL=            # default: https://www.abarrey.com/ofertas.php (página pública de ofertas)

# ── Supermercados (scraping) ──────────────────────────────────
# URL base (dominio) de cada tienda. El catálogo (delsol_config.json, etc.)
# guarda solo el url_path; el spider arma la URL final = BASE_URL + url_path.
# Si las dejas vacías, se usan estos mismos valores por defecto.
SORIANA_BASE_URL=https://www.soriana.com
DELSOL_BASE_URL=https://www.delsol.com.mx
BENAVIDES_BASE_URL=https://www.benavides.com.mx
GUADALAJARA_BASE_URL=https://www.farmaciasguadalajara.com

# ── APIs de IA ────────────────────────────────────────────────
OLLAMA_API_KEY=
GOOGLE_API_KEY=

# ── API REST de gasolineras ───────────────────────────────────
GASOLINA_API_REST=
GASOLINERAS_UBI=

# ── CNE (Comisión Nacional de Energía / CRE) ──────────────────
CNE_REFER=
CNE_LOCALIDADES_URL=
CNE_PRECIOS_GAS_LP_URL=

# ── Base de datos ─────────────────────────────────────────────
# Por defecto SINA usa PostgreSQL + pgvector (ver compose.yaml). Estos valores
# coinciden con compose.yaml; déjalos así para usar el contenedor local.
# Si BORRAS host/name/user/password, SINA cae a SQLite local (solo desarrollo).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sina_db
DB_USER=sina_admin
DB_PASSWORD=sina_password

# ── Scheduler (Fase 1) ────────────────────────────────────────
# 1/true  = actualizaciones automáticas (gasolina diario 06:00, gas LP sáb 08:00, hora MX).
# 0/false = desactivar (útil en desarrollo para no llamar a las APIs de gobierno).
ENABLE_SCHEDULER=1

# Scraping automático de supermercados (Soriana/Del Sol/Benavides), domingo 04:00 MX.
# Es un job PESADO (Soriana y Del Sol usan navegador headless) — desactivado por
# defecto; actívalo solo en un worker dedicado, no en el proceso web.
ENABLE_SUPERMERCADOS_SCRAPING=0

# ── Embeddings de productos (Fase 2) ──────────────────────────
# 1/true  = al hacer upsert de productos se generan embeddings (requiere PostgreSQL+pgvector
#           y descargar el modelo). Habilita la búsqueda semántica en /api/v1/supermercados.
# 0/false = sin embeddings; la búsqueda cae a texto (ILIKE) por nombre.
ENABLE_EMBEDDINGS=0
# Modelo de embeddings (open-source, intercambiable). Por defecto Qwen3-Embedding-8B (pesado);
# para PCs sin GPU considera uno más ligero, p. ej. intfloat/multilingual-e5-small.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ── Auth + Seguridad (Fase 4) ─────────────────────────────────
# Entorno: dev | prod. En prod se activan cookies Secure y HSTS.
SINA_ENV=dev
# Client ID PÚBLICO de Google OAuth (Google Cloud Console → Credenciales → ID de
# cliente OAuth 2.0, tipo "Aplicación web"). Vacío = login deshabilitado.
GOOGLE_OAUTH_CLIENT_ID=
# Clave para FIRMAR la sesión (HMAC). Obligatoria en prod, alta entropía.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Vida de la sesión en segundos (por defecto 14 días).
SESSION_TTL=1209600
# Orígenes permitidos por CORS (coma-separados). Vacío = mismo origen (SPA
# servida por FastAPI). Solo se necesita si el frontend se despliega aparte.
CORS_ORIGINS=
# Clave para endpoints administrativos (dispara scraping/escrituras). Sin ella,
# esos POST responden 503 (cerrado por defecto). En prod: Secret Manager.
ADMIN_API_KEY=

# ── Pool de conexiones (escalabilidad) ────────────────────────
# Conexiones por instancia. Mantenlas bajas y escala con más instancias para no
# agotar max_connections de Cloud SQL.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Chat / Agente LLM (Fase 3) ────────────────────────────────
# 1/true = habilita el asistente en POST /api/v1/chat. 0/false = responde 503.
ENABLE_CHAT=0
# Proveedor de LLM: "ollama" (local). En el futuro "gemini" (GCP) con su subclase.
LLM_PROVIDER=ollama
# Ollama local. El modelo DEBE soportar tool-calling (p. ej.: ollama pull qwen2.5:7b).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Temperatura (baja = respuestas más deterministas) y tope de iteraciones del grafo.
LLM_TEMPERATURE=0.2
LLM_MAX_ITERS=6

# ── Extracción de flyers por VLM (Fase 6) ─────────────────────
# 1/true = habilita la extracción por zona en POST /api/v1/annotator/extract.
ENABLE_VLM=0
# Proveedor de VLM: "ollama" (local) hoy; "gemini" (GCP) futuro con su subclase.
VLM_PROVIDER=ollama
# Modelo de VISIÓN local (ej.: ollama pull qwen2.5vl:7b). Con OLLAMA_API_KEY usa la nube.
VLM_MODEL=qwen2.5vl:7b
VLM_HOST=http://localhost:11434

# ── Historial de chat en MongoDB (Fase 3) ─────────────────────
# Local por ahora (contenedor de compose.yaml). Al patrocinar un servidor, solo
# cambia MONGO_URI. Si Mongo no está disponible, el chat funciona SIN persistencia.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sina
# Conversaciones por usuario (tope) y tamaño del bucket de mensajes por documento.
CHAT_MAX_CONVERSACIONES=5
CHAT_CHUNK_SIZE=15